<h1><code><%= @inbound_request_log.path %></code></h1>
<h4 class="mb-4 text-secondary"><%= @inbound_request_log.method %> <%= @inbound_request_log.response_code %> • <%= @inbound_request_log.started_at %> → <%= @inbound_request_log.ended_at %></h4>

<h3>Related object</h3>
<div class="mb-3">
  <% if @inbound_request_log.loggable&.is_a?(ActivityPub::Object) %>
    <%= link_to @inbound_request_log.loggable.becomes(ActivityPub::Object) do %>
      <code><%= [@inbound_request_log.loggable_type, @inbound_request_log.loggable_id].join(':') %></code>
    <% end %>
  <% end %>
</div>

<h3>Request body</h3>
<pre><%= JSON.pretty_generate(@inbound_request_log.request_body) if @inbound_request_log.request_body %></pre>

<h3>Response body</h3>
<pre><%= @inbound_request_log.response_body %></pre>
