<% @max_width = '7xl' %>
<% @col_start = 2 %>
<% actor_presenter = ActorPresenter.new(@result) %>

<%= render(PageComponent.new(title: "Search results for #{params[:q]}")) do %>
  <% if @mode == :actor %>
      <div class="flex items-center gap-3 mt-3">
        <img src="<%= actor_presenter.icon_url %>" width="50" height="50" class="rounded-full">

        <div>
          <p class="font-bold"><%= @result.name %></p>
          <p class="text-sm text-gray-500">@<%= @result.username %>@<%= @result.server %></p>
        </div>

        <div class="ml-auto flex items-center gap-4">
          <a href="#" class="text-blue-500">Follow</a>
        </div>
      </div>
  <% elsif @mode == :post %>
    <div class="mt-3">
      <%= render "panel/posts/post", post: @result %>
    </div>
  <% end %>
<% end %>
