<% if block.children_count.positive? %>
  <div class="flex gap-1">
    <% block.children.each do |child| %>
      <div class="w-1/<%= block.children_count %> relative">
        <%= button_to panel_block_image_path(child), method: :delete,class: 'absolute top-2 right-2 p-1 text-red-500 hover:bg-red-500 hover:text-white' do %>
          <%= tabler_icon :x, size: 12 %>
        <% end %>

        <img src="<%= child.blockable.file_url(host: nil) %>" class="h-full object-cover">
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-gray-50 px-4 py-24 text-center text-gray-500 text-sm cursor-pointer"
    data-controller="image-set-upload"
    data-action="click->image-set-upload#openFilePicker"
    data-image-set-upload-final-url-value="<%= refresh_panel_post_block_path(block.resource, block) %>">
    <div class="mt-6">
      <%= tabler_icon :photo, size: 50, class: 'text-gray-300 mx-auto mb-2' %>
      <div class="mt-2 text-sm text-gray-500" data-image-set-upload-target="progress">Upload images</div>

      <%= form_with model: ::Block.new,
        url: panel_block_images_path,
        class: 'hidden',
        data: { controller: "block-form", "image-set-upload-target": "form" } do |form| %>
        <%= form.hidden_field :parent_id, value: block.id %>
        <%= form.fields_for :blockable, ::Block::Image.new do |blockable_fields| %>
          <%= blockable_fields.file_field :file, multiple: true, data: { action: "change->image-set-upload#upload", "image-set-upload-target": "input" } %>
        <% end %>

      <% end %>
    </div>
  </div>
<% end %>
