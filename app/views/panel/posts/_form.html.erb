<%= form_with model: [:panel, post], class: "mt-3", id: :post_form do |form| %>
  <% if post.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.rich_text_area :content, data: { direct_upload_url: main_app.lexxy_uploads_path, blob_url_template: main_app.lexxy_medium_blob_path(":signed_id", ":filename") } %>
<% end %>
