<article class="bg-white rounded-lg mb-6 border-b">
  <header>
    <div href="" class="flex items-center py-4 px-2 pt-0">
      <div class="flex items-center">
        <%= image_tag post.federails_actor.entity.logo_url || 'https://mockmind-api.uifaces.co/content/human/80.jpg', class: "w-10 h-10 rounded-full mr-3" %>

        <span class="font-bold">
          <%= post.federails_actor.name || post.federails_actor.username %>
        </span>
      </div>

      <div class="ml-auto flex items-center gap-4">
        <a href="#" class="text-blue-500">Follow</a>
        <div data-controller="dropdown" data-dropdown-placement-value="bottom-end" class="relative inline-block">
          <button
            type="button"
            data-dropdown-target="button"
            data-action="click->dropdown#toggle"
            class="inline-flex items-center text-gray-600 hover:bg-gray-100 p-2 rounded-full h-10 w-10"
          >
            <%= tabler_icon :dots, size: 28 %>
          </button>

          <div
            data-dropdown-target="menu"
            class="hidden bg-white border rounded shadow-md p-2 min-w-48"
          >
            <a href="<%= edit_panel_post_path(post) %>" class="block px-4 py-2 hover:bg-gray-100">Edit</a>
            <a href="#" class="block px-4 py-2 hover:bg-gray-100">Stop following <%= post.federails_actor.name || post.federails_actor.username %></a>
            <a href="#" class="text-red-500 block px-4 py-2 hover:bg-gray-100">Delete</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <% post.blocks.where(depth: 0).each do |block| %>
    <div class="mb-6">
      <% if block.blockable_type == 'Block::ImageSet' %>
        <div class="grid grid-column gap-1">
          <% block.children.each do |image| %>
            <% blockable = image.blockable %>

            <%= link_to blockable.file_url do %>
              <%= image_tag blockable.file_url, width: blockable.file.metadata['width'], height: blockable.file.metadata['height'] %>
            <% end %>
          <% end %>
        </div>
      <% elsif block.blockable_type == 'Block::RichText' %>
        <div class="px-2">
          <%= block.blockable.content %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="p-4 pt-0 px-2">
    <% tags = ["Pontiac", "Pontiac Banshee", "1966", "60 year ago", "dead brands", "concept", "prototype", "Sixty years going nowhere", "John Z. DeLorean", "design study"] %>
    <% tags.each do |tag| %>
      <%= link_to "##{tag}", "#", class: "mr-2 text-gray-500 hover:underline" %>
    <% end %>
  </div>

  <footer class="flex items-center place-content-between p-4 px-2 pt-0 text-gray-600">
    <a href="#"><%= tabler_icon :message_circle, size: 28 %></a>
    <a href="#" class="flex items-center gap-2 text-sm"><%= tabler_icon :refresh, size: 28 %>49</a>
    <a href="#" class="flex items-center gap-2 text-sm"><%= tabler_icon :heart, size: 28 %> <%= post.likes_count %></a>
    <a href="#"><%= tabler_icon :share_2, size: 28 %></a>
  </footer>
</article>
